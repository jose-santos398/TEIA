```yaml
name: TEIA CI

on:
  push:
    branches: [main]

  pull_request:
    branches: [main]

jobs:

  backend:
    runs-on: ubuntu-latest

    defaults:
      run:
        working-directory: sitebackend

    steps:
      - name: Checkout código
        uses: actions/checkout@v4

      - name: Configurar Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
          cache: maven

      - name: Permissão Maven Wrapper
        run: chmod +x mvnw

      - name: Build + testes backend
        run: ./mvnw clean verify

  frontend:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout código
        uses: actions/checkout@v4

      - name: Configurar Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - name: Instalar dependências
        run: npm ci

      - name: Auditoria de segurança
        run: npm audit --audit-level=high

      - name: Build frontend
        run: npm run build

      - name: Executar testes frontend
        run: npm run test:run

      - name: Verificar ESLint
        run: npm run lint

  docker:
    runs-on: ubuntu-latest

    needs:
      - backend
      - frontend

    steps:
      - name: Checkout código
        uses: actions/checkout@v4

      - name: Build Docker
        run: docker build -t teia-app .

      - name: Testar container
        run: |
          docker run -d --name teia-test -p 8080:8080 teia-app
          sleep 15
          docker ps

      - name: Healthcheck container
        run: curl --fail http://localhost:8080 || exit 1

      - name: Parar container
        run: docker stop teia-test
```
